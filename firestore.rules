rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Firm staff allow-list. Server-side writes (Admin SDK / Netlify functions)
    // bypass these rules entirely.
    function isStaff() {
      return request.auth != null &&
        request.auth.token.email in ['arthur@truesteadlaw.com', 'simp70@gmail.com'];
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Client records created at signup (start.html signUp/signInGoogle).
    match /clients/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isStaff();
    }
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isStaff();
    }
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read: if isStaff();
    }

    // Secure two-way messaging. Client reads their own thread and may post
    // messages tagged from:'client'; staff can read/write/moderate any thread.
    match /attyMessages/{uid}/messages/{msgId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create: if request.auth != null && (
        isStaff() ||
        (request.auth.uid == uid && request.resource.data.from == 'client')
      );
      allow update, delete: if isStaff();
    }

    // Case status — one doc per client, set by staff, read by the client.
    match /matters/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if isStaff();
    }

    // Retainer agreements — staff/DocuSign webhook writes status; client reads.
    match /retainers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if isStaff();
    }

    // Collaborative sessions — scoped to the people in the session.
    // The sessionId is a 128-bit unguessable token (see genCollabId), and it
    // doubles as the share-link credential. Access is granted to: the creator,
    // anyone already in the participants map, an attorney, or — to allow a new
    // guest to join via the link — while the session is still 'waiting'.
    match /collab/{sessionId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.status == 'waiting' ||
        (resource.data.keys().hasAny(['participants']) &&
          request.auth.uid in resource.data.participants) ||
        isStaff()
      );
    }
    // Staff list — attorney writes, staff reads their own record
    match /staff/{emailKey} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
