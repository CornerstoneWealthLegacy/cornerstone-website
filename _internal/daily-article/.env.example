# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Only one key is needed — research uses Claude's built-in web search (no Tavily).

# Anthropic API key — https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# (Optional) Hero images use the `higgsfield` CLI, authenticated separately via
# `higgsfield auth login` — no key goes here. Run with --no-image to skip images.
