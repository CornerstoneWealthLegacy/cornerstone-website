<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent — runs the Truestead daily video agent at 6:30 AM.
  Fires 30 minutes after the article agent (6:00 AM) so the article is live.

  INSTALL:
    cp "/Users/arthursimpson/claude 1/cornerstone-website/_internal/daily-video/com.truestead.daily-video.plist" ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.truestead.daily-video.plist

  STATUS:   launchctl list | grep truestead
  RUN NOW:  launchctl start com.truestead.daily-video
  LOGS:     cat /tmp/truestead-video.log
            cat /tmp/truestead-video-error.log
  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.truestead.daily-video.plist
    rm ~/Library/LaunchAgents/com.truestead.daily-video.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.truestead.daily-video</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/arthursimpson/claude 1/cornerstone-website/_internal/daily-video/daily-video.js</string>
  </array>

  <!-- Every day at 6:30 AM — 30 min after the article agent -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ANTHROPIC_API_KEY</key>
    <string>REPLACE_WITH_YOUR_ANTHROPIC_KEY</string>
    <key>ELEVENLABS_API_KEY</key>
    <string>REPLACE_WITH_YOUR_ELEVENLABS_KEY</string>
    <key>ELEVENLABS_VOICE_ID</key>
    <string>REPLACE_WITH_YOUR_VOICE_ID</string>
    <key>POSTIZ_API_KEY</key>
    <string>REPLACE_WITH_YOUR_POSTIZ_KEY</string>
    <key>POSTIZ_CHANNEL_IDS</key>
    <string>REPLACE_WITH_CHANNEL_IDS</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/arthursimpson/claude 1/cornerstone-website/_internal/daily-video</string>

  <key>StandardOutPath</key>
  <string>/tmp/truestead-video.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/truestead-video-error.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
