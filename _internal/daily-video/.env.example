# Truestead Daily Video Agent — env vars
# Copy to .env and fill in values (never commit .env)

ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — https://elevenlabs.io/app/voice-lab
# Clone your voice: Voices → Add Voice → Instant Voice Clone → upload samples
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...   # your cloned voice ID (not a library voice)

# HeyGen — https://app.heygen.com
# Create avatar: Avatars → Instant Avatar → record 2-min video
# Get API key: Settings → API
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=...      # your avatar ID from HeyGen → Avatars → click yours → copy ID
HEYGEN_VOICE_ID=...       # optional — HeyGen voice tied to your avatar (leave blank to use avatar default)

# Postiz — https://postiz.com → Settings → API Keys
# Get channel IDs: Channels → click each platform → copy ID from URL
POSTIZ_API_KEY=...
POSTIZ_CHANNEL_IDS=...    # comma-separated: abc123,def456,ghi789
